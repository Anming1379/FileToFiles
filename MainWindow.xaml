<Window x:Class="FileToFiles.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:utils="clr-namespace:FileToFiles.Utils"
        mc:Ignorable="d"
        Title="File To Files"
        Icon="pack://application:,,,/FileToFiles;component/assets/icon.ico"
        Width="1260"
        Height="800"
        MinWidth="1000"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        AllowDrop="True"
        DragEnter="OnWindowDragEnter"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop">

    <Window.Resources>
        <utils:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <utils:InverseBoolConverter x:Key="InverseBool" />
        <utils:QualityModeToVisibilityConverter x:Key="QualityModeVisibility" />
        <utils:AudioQualityAvailableConverter x:Key="AudioQualityEnabled" />
        <utils:HardwareOptionEnabledConverter x:Key="HardwareEnabled" />

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PlaceholderIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PlaceholderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>

        <Style x:Key="PlaceholderSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <DataTemplate x:Key="ChoiceItemTemplate">
            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="PresetItemTemplate">
            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <!-- 设置分组容器 -->
        <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBase}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

    </Window.Resources>

    <Grid x:Name="RootLayer" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform Y="0" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 工具栏 ==================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <Grid Height="58" Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}"
                               Text="&#xE04B;"
                               FontSize="20"
                               Foreground="{DynamicResource Brush.Accent}"
                               Margin="2,0,8,0" />
                    <TextBlock Text="File To Files"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Border Width="1" Height="20" Background="{DynamicResource Brush.Border}" Margin="16,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="添加文件"
                            Click="OnAddFilesClick"
                            ToolTip="添加一个或多个媒体文件">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE145;" FontSize="17" Margin="0,0,6,0" />
                            <TextBlock Text="添加文件" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="添加文件夹"
                            Click="OnAddFolderClick"
                            ToolTip="添加文件夹（递归扫描支持的格式）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE2C8;" FontSize="17" Margin="0,0,6,0" />
                            <TextBlock Text="添加文件夹" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            AutomationProperties.Name="清空列表"
                            Command="{Binding ClearAllCommand}"
                            ToolTip="清空输入列表">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE16C;" FontSize="17" Margin="0,0,6,0" />
                            <TextBlock Text="清空" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Column="2"
                        Width="1"
                        Height="20"
                        Background="{DynamicResource Brush.Border}"
                        Margin="12,0"
                        VerticalAlignment="Center" />

                <!-- 预设选择 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Caption}" Text="目标格式" Margin="0,0,8,0" />
                    <ComboBox Width="248"
                              ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                              ItemTemplate="{StaticResource PresetItemTemplate}"
                              ToolTip="整批文件统一使用这个预设；修改参数后名称前会加 *" />
                    <TextBlock Style="{StaticResource Caption}"
                               Margin="10,0,0,0"
                               Text="{Binding SelectedPreset.TargetTitle}" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource PrimaryButton}"
                            Width="128"
                            AutomationProperties.Name="开始转换"
                            Command="{Binding StartConversionCommand}"
                            Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                            ToolTip="按当前预设转换列表中的全部文件">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE037;" FontSize="17" Margin="0,0,6,0" />
                            <TextBlock Text="开始转换" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}"
                            Width="128"
                            AutomationProperties.Name="停止转换"
                            Command="{Binding StopConversionCommand}"
                            Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="停止全部转换任务并清理临时文件">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE047;" FontSize="17" Margin="0,0,6,0" />
                            <TextBlock Text="停止" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Column="5"
                        AutomationProperties.Name="设置"
                        Style="{StaticResource IconButton}"
                        Content="&#xE8B8;"
                        Margin="10,0,0,0"
                        Click="OnSettingsClick"
                        ToolTip="设置" />
            </Grid>
        </Border>

        <!-- ==================== 崩溃提示 ==================== -->
        <Border Grid.Row="1"
                Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="16,7">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="0" />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasCrashReport}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="-34"
                                                         To="0"
                                                         Duration="0:0:0.24">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}"
                               Text="&#xE002;"
                               FontSize="16"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource Brush.Warning}" />
                    <TextBlock Text="{Binding CrashReportText}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}"
                            Height="26"
                            Padding="8,0"
                            FontSize="12"
                            Content="查看日志"
                            Command="{Binding OpenCrashLogCommand}" />
                    <Button Style="{StaticResource GhostButton}"
                            Height="26"
                            Padding="8,0"
                            FontSize="12"
                            Margin="6,0,0,0"
                            Content="知道了"
                            Command="{Binding DismissCrashReportCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== 选项卡 ==================== -->
        <TabControl Grid.Row="2" SelectionChanged="OnTabSelectionChanged">

            <!-- ===== Tab 1：输入文件 ===== -->
            <TabItem Header="输入文件">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView x:Name="FileList"
                              Grid.Row="0"
                              Margin="10,10,10,6"
                              ItemsSource="{Binding Files}"
                              SelectionMode="Extended"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              PreviewMouseRightButtonDown="OnFileListPreviewMouseRightButtonDown">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="文件名" Width="300">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Icon}"
                                                           Text="{Binding KindGlyph}"
                                                           FontSize="16"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                                <TextBlock Text="{Binding FileName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding FullPath}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="源容器" Width="86">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource CellText}" Text="{Binding ContainerText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="源视频编码" Width="112">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource CellText}"
                                                       Text="{Binding VideoCodecText}"
                                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="源音频编码" Width="112">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource CellText}"
                                                       Text="{Binding AudioCodecText}"
                                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="时长" Width="86">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource CellText}" Text="{Binding DurationText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="分辨率" Width="106">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource CellText}" Text="{Binding ResolutionText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="大小" Width="96">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource CellText}" Text="{Binding SizeText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="状态" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.TextDisabled}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Probing">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Info}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Canceled">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.TextSecondary}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="进度" Width="118">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProgressText}"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                           VerticalAlignment="Center" />
                                                <ProgressBar Value="{Binding Progress}"
                                                             Maximum="100"
                                                             Height="3"
                                                             VerticalAlignment="Bottom" />
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>

                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="查看媒体详情"
                                          Command="{Binding ShowDetailsCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE88E;" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="打开源目录"
                                          Command="{Binding OpenSourceFolderCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE2C8;" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="重新探测"
                                          Command="{Binding RecheckItemCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE5D5;" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="从列表移除"
                                          Command="{Binding RemoveItemCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE872;" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>

                    <Border Grid.Row="0" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=FileList}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource PlaceholderIcon}" Text="&#xE171;" />
                            <TextBlock Style="{StaticResource PlaceholderTitle}" Text="把文件或文件夹拖到这里" />
                            <TextBlock Style="{StaticResource PlaceholderSubtitle}"
                                       Text="也可以使用左上角的「添加文件」「添加文件夹」" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,1,0,0"
                            Padding="16,8">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding SummaryText}" Style="{StaticResource Caption}" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProbeSummaryText}" Style="{StaticResource Caption}" Margin="0,0,14,0" />
                                <Button Style="{StaticResource GhostButton}"
                                        Height="26"
                                        Padding="8,0"
                                        FontSize="12"
                                        Command="{Binding RecheckAllCommand}"
                                        Content="重新探测全部" />
                                <Button Style="{StaticResource GhostButton}"
                                        Height="26"
                                        Padding="8,0"
                                        FontSize="12"
                                        Margin="6,0,0,0"
                                        Command="{Binding RemoveSelectedCommand}"
                                        Content="移除选中" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== Tab 2：转换设置 ===== -->
            <TabItem Header="{Binding SettingsTabTitle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 预设 -->
                            <Border Grid.Row="0" Style="{StaticResource GroupBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource GroupHeader}">
                                        <Border Width="3"
                                                Height="13"
                                                Background="{DynamicResource Brush.Accent}"
                                                Margin="0,0,9,0"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="预设" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               Style="{StaticResource FieldLabelInline}"
                                               Text="当前预设" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox Width="320"
                                                  ItemsSource="{Binding Presets}"
                                                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                                  ItemTemplate="{StaticResource PresetItemTemplate}" />
                                        <Button Command="{Binding ResetPresetCommand}"
                                                Margin="12,0,0,0"
                                                Content="恢复默认"
                                                ToolTip="恢复该预设的原始参数" />
                                        <Button Click="OnSavePresetClick"
                                                Margin="8,0,0,0"
                                                Content="另存为自定义预设"
                                                ToolTip="把当前参数保存成新的预设（本次会话有效）" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="1"
                                               Style="{StaticResource Caption}"
                                               Margin="0,12,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding SelectedPreset.Summary}" />
                                </Grid>
                            </Border>

                            <!-- 视频 + 音频 -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 视频参数 -->
                                <Border Visibility="{Binding SelectedPreset.IsVideo, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource GroupBorder}">
                                            <Setter Property="Margin" Value="0,0,0,14" />
                                            <Setter Property="Grid.Column" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPreset.IsImageSequence}" Value="True">
                                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource GroupHeader}">
                                            <Border Width="3"
                                                    Height="13"
                                                    Background="{DynamicResource Brush.Accent}"
                                                    Margin="0,0,9,0"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Text="视频" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Style="{StaticResource FieldLabelInline}"
                                                   Margin="0,0,16,14" Text="目标容器" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,14"
                                                  Style="{StaticResource FieldCombo}"
                                                  ItemsSource="{Binding ContainerChoices}"
                                                  ItemTemplate="{StaticResource ChoiceItemTemplate}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedPreset.Container, Mode=TwoWay}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Style="{StaticResource FieldLabelInline}"
                                                   Margin="0,0,16,14" Text="视频编码"
                                                   Visibility="{Binding SelectedPreset.IsImageSequence, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,14"
                                                  Style="{StaticResource FieldCombo}"
                                                  Visibility="{Binding SelectedPreset.IsImageSequence, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                                  ItemsSource="{Binding VideoCodecChoices}"
                                                  ItemTemplate="{StaticResource ChoiceItemTemplate}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedPreset.VideoCodec, Mode=TwoWay}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0"
                                                   Style="{StaticResource FieldLabelInline}"
                                                   Margin="0,0,16,14" Text="质量模式"
                                                   Visibility="{Binding SelectedPreset.IsImageSequence, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,14"
                                                  Style="{StaticResource FieldCombo}"
                                                  Visibility="{Binding SelectedPreset.IsImageSequence, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                                  ItemsSource="{Binding QualityModeChoices}"
                                                  ItemTemplate="{StaticResource ChoiceItemTemplate}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedPreset.QualityMode, Mode=TwoWay}" />

                                        <TextBlock Grid.Row="4" Grid.Column="0"
                                                   Margin="0,0,16,14" Text="CRF 质量"
                                                   ToolTip="0–51，数值越小画质越好、文件越大">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabelInline}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding SelectedPreset.QualityMode}" Value="Crf" />
                                                                <Condition Binding="{Binding SelectedPreset.IsImageSequence}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,14"
                                                    Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding SelectedPreset.QualityMode}" Value="Crf" />
                                                                <Condition Binding="{Binding SelectedPreset.IsImageSequence}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Slider Width="200"
                                                    Minimum="0"
                                                    Maximum="51"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding SelectedPreset.Crf, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding SelectedPreset.Crf}"
                                                       MinWidth="28"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="5" Grid.Column="0"
                                                   Margin="0,0,16,14" Text="视频码率">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabelInline}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding SelectedPreset.QualityMode}" Value="Bitrate" />
                                                                <Condition Binding="{Binding SelectedPreset.IsImageSequence}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,14"
                                                    Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding SelectedPreset.QualityMode}" Value="Bitrate" />
                                                                <Condition Binding="{Binding SelectedPreset.IsImageSequence}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBox Width="120"
                                                     Text="{Binding SelectedPreset.VideoBitrateKbps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource Caption}" Text="kbps" Margin="10,0,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="6" Grid.Column="0"
                                                   Style="{StaticResource FieldLabelInline}"
                                                   Margin="0,0,16,14" Text="分辨率" />
                                        <ComboBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,14"
                                                  Style="{StaticResource FieldCombo}"
                                                  ItemsSource="{Binding ResolutionChoices}"
                                                  ItemTemplate="{StaticResource ChoiceItemTemplate}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedPreset.Resolution, Mode=TwoWay}" />

                                        <TextBlock Grid.Row="7" Grid.Column="0"
                                                   Style="{StaticResource FieldLabelInline}"
                                                   Margin="0,0,16,0" Text="帧率" />
                                        <ComboBox Grid.Row="7" Grid.Column="1"
                                                  Style="{StaticResource FieldCombo}"
                                                  ItemsSource="{Binding FrameRateChoices}"
                                                  ItemTemplate="{StaticResource ChoiceItemTemplate}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedPreset.FrameRate, Mode=TwoWay}" />
                                    </Grid>
                                </Border>

                                <!-- 图片 / 动图参数 -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource GroupBorder}">
                                            <Setter Property="Margin" Value="0,0,0,14" />
                                            <Setter Property="Grid.Column" Value="0" />
                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPreset.IsImage}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource GroupHeader}">
                                            <Border Width="3"
                                                    Height="13"
                                                    Background="{DynamicResource Brush.Accent}"
                                                    Margin="0,0,9,0"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Text="图片" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Style="{StaticResource FieldLabelInline}"
                                                   Margin="0,0,16,14" Text="目标格式" />
                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,22,14"
                                                  Style="{StaticResource FieldCombo}"
                                                  ItemsSource="{Binding ImageContainerChoices}"
                                                  ItemTemplate="{StaticResource ChoiceItemTemplate}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedPreset.Container, Mode=TwoWay}" />

                                        <TextBlock Grid.Row="1" Grid.Column="2"
                                                   Style="{StaticResource FieldLabelInline}"
                                                   Margin="0,0,16,14" Text="尺寸" />
                                        <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,14"
                                                  Style="{StaticResource FieldCombo}"
                                                  ItemsSource="{Binding ResolutionChoices}"
                                                  ItemTemplate="{StaticResource ChoiceItemTemplate}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedPreset.Resolution, Mode=TwoWay}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Margin="0,0,16,0" Text="质量"
                                                   ToolTip="1–100，数值越大画质越好、文件越大；PNG / BMP / TIFF 为无损格式">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabelInline}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedPreset.HasImageQuality}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedPreset.HasImageQuality}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Slider Width="180"
                                                    Minimum="1"
                                                    Maximum="100"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    Value="{Binding SelectedPreset.ImageQuality, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding SelectedPreset.ImageQuality}"
                                                       MinWidth="32"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Grid.Column="2"
                                                   Margin="0,0,16,0" Text="帧率"
                                                   ToolTip="仅动图格式使用；“保持原始”会自动限制在 20 fps 以内">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabelInline}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedPreset.IsAnimatedImageTarget}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <DockPanel Grid.Row="2" Grid.Column="3">
                                            <DockPanel.Style>
                                                <Style TargetType="DockPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedPreset.IsAnimatedImageTarget}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DockPanel.Style>
                                            <CheckBox DockPanel.Dock="Right"
                                                      Content="循环播放"
                                                      Margin="14,0,0,0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding SelectedPreset.LoopAnimation, Mode=TwoWay}" />
                                            <ComboBox Style="{StaticResource FieldCombo}"
                                                      ItemsSource="{Binding FrameRateChoices}"
                                                      ItemTemplate="{StaticResource ChoiceItemTemplate}"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding SelectedPreset.FrameRate, Mode=TwoWay}" />
                                        </DockPanel>
                                    </Grid>
                                </Border>

                                <!-- 音频参数：宽窗口下两个字段并排 -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource GroupBorder}">
                                            <Setter Property="Margin" Value="0,0,0,14" />
                                            <Setter Property="Grid.Column" Value="0" />
                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPreset.IsAudio}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.ColumnSpan="4" Style="{StaticResource GroupHeader}">
                                            <Border Width="3"
                                                    Height="13"
                                                    Background="{DynamicResource Brush.Accent}"
                                                    Margin="0,0,9,0"
                                                    VerticalAlignment="Center" />
                                            <TextBlock Text="音频" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Style="{StaticResource FieldLabelInline}"
                                                   Text="音频编码" />
                                        <ComboBox Grid.Row="1" Grid.Column="1"
                                                  Margin="0,0,22,0"
                                                  Style="{StaticResource FieldCombo}"
                                                  ItemsSource="{Binding AudioCodecChoices}"
                                                  ItemTemplate="{StaticResource ChoiceItemTemplate}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedPreset.AudioCodec, Mode=TwoWay}" />

                                        <TextBlock Grid.Row="1" Grid.Column="2"
                                                   Style="{StaticResource FieldLabelInline}"
                                                   Text="码率 / 质量" />
                                        <ComboBox Grid.Row="1" Grid.Column="3"
                                                  Style="{StaticResource FieldCombo}"
                                                  ItemsSource="{Binding AudioQualityChoices}"
                                                  ItemTemplate="{StaticResource ChoiceItemTemplate}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedPreset.AudioQualityKey, Mode=TwoWay}"
                                                  IsEnabled="{Binding SelectedPreset.AudioCodec, Converter={StaticResource AudioQualityEnabled}}" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 高级 -->
                            <Border Grid.Row="2" Style="{StaticResource GroupBorder}" Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource GroupHeader}">
                                        <Border Width="3"
                                                Height="13"
                                                Background="{DynamicResource Brush.Accent}"
                                                Margin="0,0,9,0"
                                                VerticalAlignment="Center" />
                                        <TextBlock Text="高级" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Style="{StaticResource FieldLabelInline}"
                                               Margin="0,0,16,0" Text="硬件加速" />
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              Width="220"
                                              HorizontalAlignment="Left"
                                              ItemsSource="{Binding HardwareChoices}"
                                              ItemTemplate="{StaticResource ChoiceItemTemplate}"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedPreset.Hardware, Mode=TwoWay}">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource AppComboBoxItem}">
                                                <Setter Property="IsEnabled"
                                                        Value="{Binding Converter={StaticResource HardwareEnabled}}" />
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                               Style="{StaticResource Caption}"
                                               VerticalAlignment="Center"
                                               Margin="24,0,0,0"
                                               Text="{Binding Encoders.Summary}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="1"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,1,0,0"
                            Padding="18,8">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Style="{StaticResource Caption}"
                                       Text="参数修改只对本次转换有效，不影响内置预设。" />
                            <TextBlock DockPanel.Dock="Right"
                                       Style="{StaticResource Caption}"
                                       Text="{Binding SelectedPreset.TargetTitle}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== Tab 3：输出文件 ===== -->
            <TabItem Header="输出文件">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,0,0,1"
                            Padding="16,8">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}"
                                           Text="&#xE2C7;"
                                           FontSize="16"
                                           Margin="0,0,8,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                <TextBlock Style="{StaticResource Caption}" Text="输出目录" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding OutputDirectory}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="620" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}"
                                        Height="26"
                                        Padding="8,0"
                                        FontSize="12"
                                        AutomationProperties.Name="打开输出目录"
                                        Content="打开输出目录"
                                        Command="{Binding OpenOutputDirectoryCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <ListView x:Name="OutputList"
                              Grid.Row="1"
                              Margin="10,10,10,10"
                              ItemsSource="{Binding Outputs}"
                              SelectionMode="Single"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              PreviewMouseRightButtonDown="OnOutputListPreviewMouseRightButtonDown"
                              MouseDoubleClick="OnOutputListMouseDoubleClick">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="输出文件名" Width="290">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource CellText}"
                                                       Text="{Binding FileName}"
                                                       ToolTip="{Binding OutputPath}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="目标格式" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource CellText}" Text="{Binding Format}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="大小" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource CellText}" Text="{Binding SizeText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="耗时" Width="96">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource CellText}" Text="{Binding ElapsedText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="状态" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.TextSecondary}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="输出路径" Width="420">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource CellText}"
                                                       Text="{Binding OutputPath}"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       ToolTip="{Binding DetailText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>

                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="打开所在目录"
                                          Command="{Binding RevealOutputCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE2C8;" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="播放"
                                          Command="{Binding PlayOutputCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE037;" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="查看详情"
                                          Command="{Binding ShowOutputDetailCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE88E;" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="重新转换"
                                          Command="{Binding RetransformOutputCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE5D5;" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="删除输出文件"
                                          Command="{Binding DeleteOutputCommand}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                    <MenuItem.Icon>
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE872;" FontSize="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>

                    <Border Grid.Row="1" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=OutputList}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource PlaceholderIcon}" Text="&#xE2C7;" />
                            <TextBlock Style="{StaticResource PlaceholderTitle}" Text="转换完成后，输出文件会出现在这里" />
                            <TextBlock Style="{StaticResource PlaceholderSubtitle}"
                                       Text="右键可以打开目录、播放、重新转换或删除输出文件" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ==================== 状态栏 ==================== -->
        <Border Grid.Row="3"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Height="40"
                Padding="16,0">
            <DockPanel VerticalAlignment="Center" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar Width="150"
                                 Value="{Binding OverallProgress}"
                                 Maximum="100"
                                 Height="4"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ConversionProgressText}"
                               Style="{StaticResource Caption}"
                               Margin="12,0,0,0" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource Caption}"
                               Margin="14,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="330" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Style="{StaticResource Icon}"
                               Text="&#xE02C;"
                               FontSize="15"
                               Margin="0,0,6,0"
                               Foreground="{DynamicResource Brush.TextDisabled}" />
                    <TextBlock Text="{Binding CurrentFileName}"
                               Style="{StaticResource Caption}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="300" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFfmpegReady}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                        <Run Text="FFmpeg " />
                        <Run Text="{Binding FfmpegStatusText, Mode=OneWay}" />
                    </TextBlock>
                    <Border Width="1" Height="14" Background="{DynamicResource Brush.Border}" Margin="14,0" />
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                        <Run Text="并发 " />
                        <Run Text="{Binding MaxConcurrency, Mode=OneWay}" />
                    </TextBlock>
                    <Border Width="1" Height="14" Background="{DynamicResource Brush.Border}" Margin="14,0" />
                    <TextBlock Text="{Binding AppVersionText}" Style="{StaticResource Caption}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== 拖放提示层 ==================== -->
        <Border x:Name="DropOverlay"
                Grid.RowSpan="4"
                Background="{DynamicResource Brush.Overlay}"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Border BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="2" Margin="12">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}"
                               Text="&#xE171;"
                               FontSize="44"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="松开鼠标以导入文件"
                               FontSize="16"
                               Foreground="{DynamicResource Brush.Text}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
