<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题调色板 -->

    <SolidColorBrush x:Key="Brush.Window" Color="#131317" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#1B1B21" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#23232B" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#2C2C36" />
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="#1D1D24" />

    <SolidColorBrush x:Key="Brush.Border" Color="#2E2E38" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#45454F" />

    <SolidColorBrush x:Key="Brush.Text" Color="#ECECF1" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#9A9AA7" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#5E5E6B" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#6E8BFF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#8AA2FF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#5875EE" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Success" Color="#4CC38A" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#E7B341" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#EE6A62" />
    <SolidColorBrush x:Key="Brush.Info" Color="#63A9FF" />

    <SolidColorBrush x:Key="Brush.RowHover" Color="#23232C" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="#26304A" />

    <SolidColorBrush x:Key="Brush.ProgressTrack" Color="#2A2A34" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#3A3A46" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#4C4C5A" />

    <SolidColorBrush x:Key="Brush.Overlay" Color="#B3121216" />

</ResourceDictionary>
