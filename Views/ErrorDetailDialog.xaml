<Window x:Class="FileToFiles.Views.ErrorDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="转换详情"
        Icon="pack://application:,,,/FileToFiles;component/assets/icon.ico"
        Width="820"
        Height="600"
        MinWidth="560"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 概要 -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusIcon"
                               Style="{StaticResource Icon}"
                               Text="&#xE000;"
                               FontSize="18"
                               Margin="0,0,10,0"
                               Foreground="{DynamicResource Brush.Danger}" />
                    <TextBlock x:Name="TitleText"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ReasonText"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Danger}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,14">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="源文件" />
                <TextBlock x:Name="SourceText"
                           Margin="0,0,0,14"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="输出路径" />
                <TextBlock x:Name="OutputText"
                           Margin="0,0,0,14"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.TextSecondary}" />

                <!-- FFmpeg 命令 -->
                <StackPanel x:Name="CommandSection">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="FFmpeg 命令" HorizontalAlignment="Left" />
                        <Button Content="复制命令"
                                HorizontalAlignment="Right"
                                Height="26"
                                Padding="10,0"
                                FontSize="12"
                                Click="OnCopyCommandClick" />
                    </Grid>
                    <TextBox x:Name="CommandBox"
                             IsReadOnly="True"
                             Height="86"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Padding="9,7"
                             FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                             FontSize="12" />
                </StackPanel>

                <!-- 详细输出 -->
                <StackPanel x:Name="StderrSection" Margin="0,16,0,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="FFmpeg 输出（stderr）" />
                    <TextBox x:Name="StderrBox"
                             IsReadOnly="True"
                             Height="150"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Padding="9,7"
                             FontFamily="Consolas, Cascadia Mono, Microsoft YaHei UI"
                             FontSize="12" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Content="打开源目录"
                        Click="OnOpenSourceFolderClick" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="复制全部" Click="OnCopyAllClick" />
                    <Button Content="关闭"
                            Width="96"
                            Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            IsDefault="True"
                            IsCancel="True"
                            Click="OnCloseClick" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
